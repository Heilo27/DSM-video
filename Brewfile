# Apple Agent Kit Dependencies
# ============================
# Install with: brew bundle

# Note: swift-format is bundled with Xcode - use via: xcrun swift-format
# Do NOT brew install swift-format

# Code Quality
brew "swiftlint"         # Swift linting

# Build Tools  
brew "xcbeautify"        # Pretty xcodebuild output

# Utilities
brew "yq"                # YAML processor for scripts

