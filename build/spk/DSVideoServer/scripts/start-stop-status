#!/bin/sh
set -eu

PACKAGE="DSVideoServer"
BASE="/var/packages/${PACKAGE}"
VAR="${BASE}/var"
LOG="${VAR}/${PACKAGE}.log"
PIDFILE="${VAR}/server.pid"

find_go_binary() {
  # DSM 7 creates symlink: target/ -> /volume1/@appstore/PKG
  # Correct packaging: package.tgz contains backend/dsvideo-backend
  # Some broken builds have bin/dsvideo-backend or an extra DSVideoServer/ prefix.
  for p in \
    "${BASE}/target/backend/dsvideo-backend" \
    "${BASE}/target/bin/dsvideo-backend" \
    "${BASE}/target/DSVideoServer/backend/dsvideo-backend" \
    "${BASE}/target/DSVideoServer/bin/dsvideo-backend" \
    "${BASE}/target/dsvideo-backend"
  do
    if [ -x "${p}" ]; then
      echo "${p}"
      return 0
    fi
  done
  return 1
}

pid_alive() {
  # Use /proc instead of kill -0 to avoid EPERM when caller != process owner.
  [ -d "/proc/${1}" ]
}

start() {
  mkdir -p "${VAR}"

  # Ensure the live nginx conf matches our package source — DSM may regenerate
  # it from a stale cache on restarts, service events, or cert renewals.
  NGINX_SRC="${BASE}/target/nginx/DSVideoServer.conf"
  NGINX_LIVE="/etc/nginx/conf.d/dsm.pkg-static.DSVideoServer-2059624305.conf"
  if [ -f "${NGINX_SRC}" ] && [ -f "${NGINX_LIVE}" ]; then
    if ! cmp -s "${NGINX_SRC}" "${NGINX_LIVE}"; then
      echo "[${PACKAGE}] nginx conf out of date — syncing and reloading" >> "${LOG}"
      cp "${NGINX_SRC}" "${NGINX_LIVE}"
      nginx -s reload 2>/dev/null || true
    fi
  fi

  GO_BINARY="$(find_go_binary || true)"

  # Check for Go binary
  if [ -z "${GO_BINARY}" ]; then
    echo "[${PACKAGE}] Go binary not found." >> "${LOG}"
    echo "[${PACKAGE}] Expected (primary): ${BASE}/target/backend/dsvideo-backend" >> "${LOG}"
    echo "[${PACKAGE}] If you installed a gzipped/nested SPK, rebuild with spk/build-spk-macos.sh and reinstall." >> "${LOG}"
    exit 1
  fi

  if [ -f "${PIDFILE}" ] && pid_alive "$(cat "${PIDFILE}")"; then
    echo "[${PACKAGE}] already running" >> "${LOG}"
    exit 0
  fi

  # Safety net: if port is already bound (orphan from a previous crash/upgrade),
  # kill the holder so we don't immediately fail with "address already in use".
  # Port 8090 = 0x2392. Find inode then map to pid via /proc/*/fd.
  INODE="$(awk '$4 ~ /:2392 / || $4 ~ /:2392$/ {print $10}' /proc/net/tcp /proc/net/tcp6 2>/dev/null | head -1)"
  if [ -n "${INODE}" ]; then
    HOLDER_PID="$(grep -rl "socket:\[${INODE}\]" /proc/*/fd 2>/dev/null | head -1 | cut -d/ -f3)"
    if [ -n "${HOLDER_PID}" ] && pid_alive "${HOLDER_PID}"; then
      echo "[${PACKAGE}] Port ${DSVIDEO_PORT:-8090} held by pid ${HOLDER_PID} — killing orphan before start" >> "${LOG}"
      kill "${HOLDER_PID}" 2>/dev/null || true
      sleep 2
      pid_alive "${HOLDER_PID}" && kill -9 "${HOLDER_PID}" 2>/dev/null || true
      sleep 1
    fi
  fi

  # Default configuration (can be overridden by DSM package env/config files)
  export DSVIDEO_PORT="${DSVIDEO_PORT:-8090}"
  export DSVIDEO_BASE_URL="${DSVIDEO_BASE_URL:-}"
  export DSVIDEO_DB_PATH="${DSVIDEO_DB_PATH:-${VAR}/dsvideo.db}"

  # Generate JWT secret if not set - use /dev/urandom (no openssl dependency)
  if [ -z "${DSVIDEO_JWT_SECRET:-}" ]; then
    # Generate and persist the secret so it survives restarts
    SECRET_FILE="${VAR}/.jwt_secret"
    if [ -f "${SECRET_FILE}" ]; then
      DSVIDEO_JWT_SECRET="$(cat "${SECRET_FILE}")"
    else
      DSVIDEO_JWT_SECRET="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
      echo "${DSVIDEO_JWT_SECRET}" > "${SECRET_FILE}"
      chmod 600 "${SECRET_FILE}"
    fi
  fi
  export DSVIDEO_JWT_SECRET

  # Library roots should be configured by the admin post-install:
  export DSVIDEO_MOVIES_PATH="${DSVIDEO_MOVIES_PATH:-/volume1/video/Movies}"
  export DSVIDEO_TV_PATH="${DSVIDEO_TV_PATH:-/volume1/video/Shows}"

  # FFmpeg/FFprobe paths - Synology ffmpeg is typically in these locations
  # The server will auto-detect if not specified, but explicit paths are more reliable
  if [ -z "${DSVIDEO_FFMPEG_PATH:-}" ]; then
    for ffpath in /usr/bin/ffmpeg /var/packages/ffmpeg/target/bin/ffmpeg /volume1/@appstore/ffmpeg/bin/ffmpeg; do
      if [ -x "$ffpath" ]; then
        export DSVIDEO_FFMPEG_PATH="$ffpath"
        break
      fi
    done
  fi
  if [ -z "${DSVIDEO_FFPROBE_PATH:-}" ]; then
    for ffpath in /usr/bin/ffprobe /var/packages/ffmpeg/target/bin/ffprobe /volume1/@appstore/ffmpeg/bin/ffprobe; do
      if [ -x "$ffpath" ]; then
        export DSVIDEO_FFPROBE_PATH="$ffpath"
        break
      fi
    done
  fi

  # Transcode temporary directory (stored in package var for persistence/cleanup)
  export DSVIDEO_TRANSCODE_DIR="${DSVIDEO_TRANSCODE_DIR:-${VAR}/transcode}"
  mkdir -p "${DSVIDEO_TRANSCODE_DIR}"

  # TMDb API key for metadata fetching (optional but recommended)
  # Get your free API key at: https://www.themoviedb.org/settings/api
  export DSVIDEO_TMDB_API_KEY="${DSVIDEO_TMDB_API_KEY:-}"

  # Image cache directory
  export DSVIDEO_IMAGE_CACHE_DIR="${DSVIDEO_IMAGE_CACHE_DIR:-${VAR}/images}"
  mkdir -p "${DSVIDEO_IMAGE_CACHE_DIR}"

  echo "[${PACKAGE}] Starting ${GO_BINARY} with port=${DSVIDEO_PORT} db=${DSVIDEO_DB_PATH}" >> "${LOG}"
  echo "[${PACKAGE}] Movies=${DSVIDEO_MOVIES_PATH} TV=${DSVIDEO_TV_PATH}" >> "${LOG}"

  nohup "${GO_BINARY}" >> "${LOG}" 2>&1 &
  echo $! > "${PIDFILE}"
  echo "[${PACKAGE}] started (pid $(cat "${PIDFILE}"))" >> "${LOG}"

  # Verify the process stays alive for a couple seconds
  sleep 2
  PID="$(cat "${PIDFILE}")"
  if ! pid_alive "${PID}"; then
    echo "[${PACKAGE}] ERROR: Process died immediately after start. Check log above for errors." >> "${LOG}"
    echo "[${PACKAGE}] Last 20 lines of log:" >> "${LOG}"
    tail -20 "${LOG}" >> "${LOG}" 2>/dev/null || true
    rm -f "${PIDFILE}"
    exit 1
  fi
}

stop() {
  if [ ! -f "${PIDFILE}" ]; then
    exit 0
  fi
  PID="$(cat "${PIDFILE}")" || true
  if [ -n "${PID}" ] && pid_alive "${PID}"; then
    kill "${PID}" 2>/dev/null || true
    # Wait up to 10 seconds for process to actually terminate before returning.
    # Without this wait, rapid package upgrades fail with "address already in use"
    # because the new binary tries to bind the port while the old one is still dying.
    i=0
    while [ $i -lt 10 ] && pid_alive "${PID}"; do
      sleep 1
      i=$((i + 1))
    done
    # Force-kill if still alive after grace period
    if pid_alive "${PID}"; then
      kill -9 "${PID}" 2>/dev/null || true
      sleep 1
    fi
  fi
  rm -f "${PIDFILE}"
  echo "[${PACKAGE}] stopped" >> "${LOG}"
}

status() {
  if [ -f "${PIDFILE}" ] && pid_alive "$(cat "${PIDFILE}")"; then
    exit 0
  fi
  exit 1
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  status) status ;;
  *) echo "usage: $0 {start|stop|status}" ; exit 2 ;;
esac
