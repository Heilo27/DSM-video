#!/bin/sh
# DSM package lifecycle: start | stop | status.  Specified in docs/frd/FRD-003-package-lifecycle.md.
#
# Rules this script lives by (each one is an incident, see the FRD):
#   - "Started" means the NEW process answers /api/v1/healthz as this build and this user.
#     A live pid or a bound port proves neither.
#   - We only ever kill OUR OWN stale backend. A foreign process on the port is diagnosed
#     loudly and left alone; start then fails instead of pretending.
#   - The package user cannot see other users' sockets under /proc/*/fd, so the holder is
#     identified from /proc/net/tcp (world-readable: it carries the uid and the socket inode).
set -eu

PACKAGE="DSVideoServer"
# DSVIDEO_PKG_BASE and DSVIDEO_PROC_ROOT exist only so spk/tests can point the script at a
# fixture tree. DSM never sets them.
BASE="${DSVIDEO_PKG_BASE:-/var/packages/${PACKAGE}}"
PROC_ROOT="${DSVIDEO_PROC_ROOT:-/proc}"
VAR="${BASE}/var"
LOG="${VAR}/${PACKAGE}.log"
PIDFILE="${VAR}/server.pid"
WATCHDOG_PIDFILE="${VAR}/watchdog.pid"
MANIFEST_NAME="MANIFEST.sha256"

SELF_UID="$(id -u)"
PORT="${DSVIDEO_PORT:-8090}"
# Exported for every command, not just start: status and stop run "dsvideo-backend
# --healthcheck", which reads DSVIDEO_PORT from its environment (default 8080 when unset).
export DSVIDEO_PORT="${PORT}"
# How long start waits for healthz to confirm the new process. The server opens and
# migrates its database before it listens, so this must outlast a slow NAS disk.
START_TIMEOUT="${DSVIDEO_START_TIMEOUT:-30}"
case "${START_TIMEOUT}" in ''|*[!0-9]*|0) START_TIMEOUT=30 ;; esac

# The build stamps INFO's version into the binary (-X main.BuildVersion), so healthz must
# report exactly this string. Empty (INFO unreadable) skips the version check, with a warning.
VERSION="$(sed -n 's/^version="\(.*\)"/\1/p' "${BASE}/INFO" 2>/dev/null | head -1 || true)"

log() {
  { echo "$(date '+%Y-%m-%dT%H:%M:%S') [${PACKAGE}] $*" >> "${LOG}"; } 2>/dev/null || true
}

find_go_binary() {
  # DSM 7 creates symlink: target/ -> /volume1/@appstore/PKG
  # Correct packaging: package.tgz contains backend/dsvideo-backend
  # Some broken builds have bin/dsvideo-backend or an extra DSVideoServer/ prefix.
  for p in \
    "${BASE}/target/backend/dsvideo-backend" \
    "${BASE}/target/bin/dsvideo-backend" \
    "${BASE}/target/DSVideoServer/backend/dsvideo-backend" \
    "${BASE}/target/DSVideoServer/bin/dsvideo-backend" \
    "${BASE}/target/dsvideo-backend"
  do
    if [ -x "${p}" ]; then
      echo "${p}"
      return 0
    fi
  done
  return 1
}

# ---------------------------------------------------------------------------------------
# Process identity and ownership
# ---------------------------------------------------------------------------------------
# Two separate questions, never merged:
#   pid_alive / pid_is_backend   "is that process a dsvideo-backend?"     (identity)
#   proc_owned_by_self           "does it run as the package user?"        (ownership)
# Identity is a guess about names; ownership is the kernel's uid. Nothing is ever signalled
# unless it is owned by us, and signal_pid is the only place a signal is sent.

# The pid exists and is not a zombie. An empty or non-numeric pid (empty pidfile) never does:
# "/proc/" is a directory.
pid_running() {
  case "${1:-}" in ''|*[!0-9]*) return 1 ;; esac
  [ -d "${PROC_ROOT}/${1}" ] || return 1
  # A zombie (exited, not yet reaped) still has /proc/$1 and a readable comm. Our own
  # start waits on a child it launched, so a child that died must read as dead here.
  _state="$(sed -n 's/^State:[[:space:]]*\(.\).*/\1/p' "${PROC_ROOT}/${1}/status" 2>/dev/null || true)"
  [ "${_state}" != "Z" ]
}

# TASK-814: existence of /proc/$1 is NOT enough. After a crash the OS can recycle the pid onto
# an unrelated process, which would report the package healthy while the server is dead and
# block restart with "already running". Is the (running) pid $1 a dsvideo-backend?
pid_is_backend() {
  # Preferred: the exe link. Exact, but readlink fails (EPERM) when the process is another
  # user's. After an in-place upgrade the kernel appends " (deleted)" to the link.
  _exe="$(readlink "${PROC_ROOT}/${1}/exe" 2>/dev/null || true)"
  _argv_n=1
  if [ -n "${_exe}" ]; then
    case "${_exe##*/}" in
      dsvideo-backend|"dsvideo-backend (deleted)") return 0 ;;
    esac
    # exe is readable and names another program. On a real DSM kernel that means a different
    # program: not ours. The one exception is an emulation layer (Rosetta, qemu-user: how
    # the lifecycle is tested on a Mac), where exe is the emulator and the real program is
    # only in comm and the command line (argv[0], or argv[1] when the emulator is argv[0]).
    # Anything else, in particular a same-uid dsvideo-backend-old or dsvideo-backend.bak
    # whose comm is truncated to the same 15 characters, is rejected here (D1).
    case "${_exe}" in
      /run/rosetta/rosetta|*/qemu-*) _argv_n=2 ;;
      *) return 1 ;;
    esac
  fi
  # exe unreadable (another user's process), or an emulator. comm is cut by the kernel to 15
  # characters and "dsvideo-backend" is exactly 15, so comm alone cannot tell it from
  # "dsvideo-backend-old": the program path in the command line must name it too. (Neither
  # readable is "not ours": nothing is ever signalled on a guess.)
  [ "$(cat "${PROC_ROOT}/${1}/comm" 2>/dev/null || true)" = "dsvideo-backend" ] || return 1
  tr '\0' '\n' < "${PROC_ROOT}/${1}/cmdline" 2>/dev/null \
    | awk -v n="${_argv_n}" 'NR <= n { sub(".*/", ""); if ($0 == "dsvideo-backend") found = 1 } END { exit !found }'
}

# Uses /proc, not kill -0, to avoid EPERM when the caller is not the process owner.
pid_alive() {
  pid_running "${1:-}" && pid_is_backend "$1"
}

# "<real uid> <effective uid>" of pid $1, empty when unreadable.
proc_uids() {
  awk '/^Uid:/ { print $2, $3; exit }' "${PROC_ROOT}/${1}/status" 2>/dev/null || true
}

# True only if pid $1 runs as the package user (real AND effective uid). Unreadable or missing
# status is "no": fail closed.
proc_owned_by_self() {
  case "${1:-}" in ''|*[!0-9]*) return 1 ;; esac
  [ "$(proc_uids "$1")" = "${SELF_UID} ${SELF_UID}" ]
}

# Process group id of pid $1, empty when unreadable. stat is "pid (comm) S ppid pgrp ...";
# comm may contain spaces and parentheses, so cut at the LAST ") ".
proc_pgrp() {
  sed 's/.*) //' "${PROC_ROOT}/${1}/stat" 2>/dev/null | awk '{ print $3; exit }' || true
}

# THE ONLY PLACE A SIGNAL IS SENT. signal_pid <pid> [TERM|KILL] [pid|group]
# Refuses (returns 1, logs) unless the process is owned by the package user, so a root-owned
# backend, another user's process, or a recycled pid is never touched, whatever identified it
# (port table, pidfile, command line). "group" signals the process group the pid leads; if the
# pid does not lead one, only the pid is signalled. Pids 0 and 1 are never signalled: kill 0
# means "my own group".
signal_pid() {
  _sg_pid="${1:-}"; _sg_sig="${2:-TERM}"; _sg_scope="${3:-pid}"
  case "${_sg_pid}" in ''|*[!0-9]*) return 1 ;; esac
  [ "${_sg_pid}" -gt 1 ] || return 1
  if ! proc_owned_by_self "${_sg_pid}"; then
    if [ -d "${PROC_ROOT}/${_sg_pid}" ]; then
      log "REFUSING to signal pid ${_sg_pid}: its uid is '$(proc_uids "${_sg_pid}")', not ours (${SELF_UID})"
    fi
    return 1
  fi
  if [ "${_sg_scope}" = "group" ] && [ "$(proc_pgrp "${_sg_pid}")" != "${_sg_pid}" ]; then
    _sg_scope="pid"
  fi
  case "${_sg_scope}:${_sg_sig}" in
    pid:TERM)   kill "${_sg_pid}" 2>/dev/null ;;
    pid:KILL)   kill -9 "${_sg_pid}" 2>/dev/null ;;
    # Numeric signal then "-pgid": the one spelling busybox ash, dash and bash all accept
    # (busybox rejects "kill -TERM -- -pgid" with "invalid number '--'").
    group:TERM) kill -15 "-${_sg_pid}" 2>/dev/null ;;
    group:KILL) kill -9 "-${_sg_pid}" 2>/dev/null ;;
    *) return 1 ;;
  esac
}

# ---------------------------------------------------------------------------------------
# Port holder detection
# ---------------------------------------------------------------------------------------

# Prints "<uid> <inode>" for every socket LISTENing on ${PORT}, IPv4 and IPv6.
#
# /proc/net/tcp columns: sl local_address rem_address st tx:rx tr:tm retrnsmt uid timeout inode.
# The port is the hex after the last colon of local_address and st 0A is LISTEN. The hex
# is computed, never hard-coded: 8090 is 0x1F9A. (The previous version carried 0x2392,
# which is 9106, so it never matched anything and the orphan killer was dead code.)
port_listeners() {
  case "${PORT}" in ''|*[!0-9]*) log "ERROR: DSVIDEO_PORT='${PORT}' is not a number"; return 2 ;; esac
  _hex="$(printf '%04X' "${PORT}")"
  for _f in "${PROC_ROOT}/net/tcp" "${PROC_ROOT}/net/tcp6"; do
    [ -r "${_f}" ] || continue
    awk -v hex="${_hex}" '$4 == "0A" { n = split($2, a, ":"); if (toupper(a[n]) == hex) print $8, $10 }' "${_f}"
  done
}

# Socket inode -> pid. Only finds processes whose /proc/PID/fd we may read (our own uid);
# a root-owned holder is invisible to the package user, which is why the uid comes from
# /proc/net/tcp instead. One ls over every fd: a readlink per fd would fork thousands of times.
holder_pid_for_inode() {
  ls -l "${PROC_ROOT}"/[0-9]*/fd/* 2>/dev/null | grep -F -- "socket:[$1]" | head -1 \
    | sed 's#.*/\([0-9][0-9]*\)/fd/[0-9]*.*#\1#' || true
}

# Classifies whatever is listening on ${PORT}. Sets:
#   HOLDER_STATE  free     nothing listening
#                 ours     our uid AND the process is our dsvideo-backend: safe to terminate
#                 foreign  anything else. NEVER killed: another uid, or our uid but not our
#                          backend, or our uid but the process cannot be identified
#   HOLDER_UID / HOLDER_INODE / HOLDER_PID (may be empty) / HOLDER_CMD (may be empty)
classify_port_holder() {
  HOLDER_STATE="free"; HOLDER_UID=""; HOLDER_INODE=""; HOLDER_PID=""; HOLDER_CMD=""
  _list="$(port_listeners)" || return 1
  [ -n "${_list}" ] || return 0

  HOLDER_STATE="ours"
  while read -r _uid _inode; do
    if [ -z "${HOLDER_UID}" ]; then HOLDER_UID="${_uid}"; HOLDER_INODE="${_inode}"; fi
    if [ "${_uid}" != "${SELF_UID}" ]; then
      HOLDER_STATE="foreign"; HOLDER_UID="${_uid}"; HOLDER_INODE="${_inode}"
      break
    fi
  done <<EOF
${_list}
EOF

  HOLDER_PID="$(holder_pid_for_inode "${HOLDER_INODE}")"
  if [ -n "${HOLDER_PID}" ]; then
    HOLDER_CMD="$(tr '\0' ' ' < "${PROC_ROOT}/${HOLDER_PID}/cmdline" 2>/dev/null || true)"
  fi
  if [ "${HOLDER_STATE}" = "ours" ]; then
    # Same socket uid is not enough: the package user could run something else on this port,
    # and only a process we may signal (see signal_pid) is ours to terminate.
    if [ -z "${HOLDER_PID}" ] || ! pid_alive "${HOLDER_PID}" || ! proc_owned_by_self "${HOLDER_PID}"; then
      HOLDER_STATE="foreign"
    fi
  fi
  return 0
}

describe_holder() {
  echo "uid=${HOLDER_UID} pid=${HOLDER_PID:-unknown (not visible to uid ${SELF_UID})} socket-inode=${HOLDER_INODE} cmdline='${HOLDER_CMD:-unknown}'"
}

# When the holder's pid is hidden from us, list every process that merely looks like our
# backend so the log says where to look. "[d]svideo" keeps grep from matching itself.
log_backend_candidates() {
  for _c in $(grep -la '[d]svideo-backend' "${PROC_ROOT}"/[0-9]*/cmdline 2>/dev/null \
      | sed 's#.*/\([0-9][0-9]*\)/cmdline#\1#' || true); do
    _cuid="$(awk '/^Uid:/ {print $2; exit}' "${PROC_ROOT}/${_c}/status" 2>/dev/null || true)"
    log "  candidate: pid ${_c} uid ${_cuid:-?} cmdline='$(tr '\0' ' ' < "${PROC_ROOT}/${_c}/cmdline" 2>/dev/null || true)'"
  done
}

log_foreign_holder() {
  log "ERROR: port ${PORT} is held by a process this package does not own and will not kill: $(describe_holder)"
  log "ERROR: package user is uid ${SELF_UID}. Stop that process as root (or an admin), then start the package again."
  [ -n "${HOLDER_PID}" ] || log_backend_candidates
}

# pid $1 is still there. Default: "still a dsvideo-backend". scope "group": "still exists and is
# not a zombie", for the child start launched itself, which is not a dsvideo-backend yet
# between fork and exec (D2).
_tp_alive() {
  if [ "${_tp_scope}" = "group" ]; then pid_running "$1"; else pid_alive "$1"; fi
}

# terminate_pid <pid> [grace=10] [pid|group]
# TERM, wait up to <grace> seconds, then KILL. Returns 0 once it is gone, 1 if it is still
# there or was refused (signal_pid logs a refusal; a process that is not ours is never
# signalled, so there is nothing to wait for and we return at once).
# scope "group" is for the child start launched: it signals the child's whole process group
# and treats a not-yet-exec'd child as alive.
terminate_pid() {
  _tp="$1"; _grace="${2:-10}"; _tp_scope="${3:-pid}"
  _tp_alive "${_tp}" || return 0
  if ! signal_pid "${_tp}" TERM "${_tp_scope}"; then
    _tp_alive "${_tp}" || return 0
    return 1
  fi
  _i=0
  while [ "${_i}" -lt "${_grace}" ] && _tp_alive "${_tp}"; do
    sleep 1
    _i=$((_i + 1))
  done
  if _tp_alive "${_tp}"; then
    log "pid ${_tp} still alive ${_grace}s after TERM; sending KILL"
    signal_pid "${_tp}" KILL "${_tp_scope}" || true
    _i=0
    while [ "${_i}" -lt 3 ] && _tp_alive "${_tp}"; do
      sleep 1
      _i=$((_i + 1))
    done
  fi
  if _tp_alive "${_tp}"; then
    return 1
  fi
  return 0
}

# Waits up to $1 seconds for the port to have no listener. Leaves HOLDER_* describing
# the last observation.
wait_port_free() {
  _i=0
  while :; do
    classify_port_holder || return 1
    [ "${HOLDER_STATE}" = "free" ] && return 0
    [ "${_i}" -ge "$1" ] && return 1
    sleep 1
    _i=$((_i + 1))
  done
}

# Start-time port clearance. Returns 0 only when the port is free.
ensure_port_free() {
  classify_port_holder || return 1
  case "${HOLDER_STATE}" in
    free) return 0 ;;
    foreign)
      log_foreign_holder
      return 1
      ;;
  esac
  log "port ${PORT} is held by a stale dsvideo-backend of ours ($(describe_holder)); terminating it"
  if ! terminate_pid "${HOLDER_PID}" 8; then
    log "ERROR: stale backend pid ${HOLDER_PID} survived TERM and KILL"
    return 1
  fi
  if ! wait_port_free 5; then
    log "ERROR: port ${PORT} is still held after terminating our stale backend: $(describe_holder)"
    [ "${HOLDER_STATE}" != "foreign" ] || log_foreign_holder
    return 1
  fi
  return 0
}

# ---------------------------------------------------------------------------------------
# Health
# ---------------------------------------------------------------------------------------

# Asks the backend on ${PORT} (via its own --healthcheck, so no curl dependency) whether it
# is pid $1, running as this uid, at this build's version, with a working database.
# Prints the reason on failure.
health_probe() {
  _hp_timeout="${2:-3s}"
  if [ -n "${VERSION}" ]; then
    "${GO_BINARY}" --healthcheck --expect-pid "$1" --expect-uid "${SELF_UID}" \
      --expect-version "${VERSION}" --timeout "${_hp_timeout}" 2>&1
  else
    "${GO_BINARY}" --healthcheck --expect-pid "$1" --expect-uid "${SELF_UID}" \
      --timeout "${_hp_timeout}" 2>&1
  fi
}

# Whole seconds since the epoch; the start deadline is wall-clock (D8).
now_s() { date +%s; }

# The start gate: success only once healthz confirms pid $1, or $2 WALL-CLOCK seconds have
# passed (probe time included: a probe that hangs for its own timeout must not stretch the
# total). Gives up early if the child dies.
#
# "Dead" here means gone or zombie (pid_running), NOT "not yet a dsvideo-backend": between
# fork and exec the child is still the launching shell (or a nohup shim) and its comm and exe
# are not the backend's. Calling that dead made start fail while the child went on to exec and
# bind the port with no pidfile (D2). The probe's --expect-pid still proves identity. Death
# must be seen twice, a second apart, so one unlucky read of /proc does not fail a start.
wait_healthy() {
  _wh_pid="$1"; _wh_max="$2"; _wh_last="no response yet"
  _wh_deadline=$(( $(now_s) + _wh_max ))
  while :; do
    if ! pid_running "${_wh_pid}"; then
      sleep 1
      if ! pid_running "${_wh_pid}"; then
        log "ERROR: pid ${_wh_pid} exited during startup. The server's own error is in the log lines above."
        return 1
      fi
    fi
    _wh_left=$(( _wh_deadline - $(now_s) ))
    [ "${_wh_left}" -gt 0 ] || break
    [ "${_wh_left}" -le 2 ] || _wh_left=2
    if _wh_out="$(health_probe "${_wh_pid}" "${_wh_left}s")"; then
      log "healthy: ${_wh_out}"
      return 0
    fi
    _wh_last="${_wh_out}"
    [ "$(now_s)" -lt "${_wh_deadline}" ] || break
    sleep 1
  done
  log "ERROR: pid ${_wh_pid} alive but not healthy after ${_wh_max}s: ${_wh_last}"
  return 1
}

# ---------------------------------------------------------------------------------------
# Integrity, permissions, log
# ---------------------------------------------------------------------------------------

# The build writes target/MANIFEST.sha256 (sha256sum format) for every shipped binary.
# A mismatch means the install is damaged or half-upgraded: refuse to run it. This catches
# accidents, not an attacker (the package user owns target/ and could rewrite both).
verify_manifest() {
  _m="${BASE}/target/${MANIFEST_NAME}"
  # $1: the binary we are about to run, relative to target/, as the manifest must name it.
  _rel="${1:-backend/dsvideo-backend}"
  if [ ! -f "${_m}" ]; then
    log "WARN: ${_m} not found; binary integrity NOT verified (package built without a manifest)"
    return 0
  fi
  if ! command -v sha256sum >/dev/null 2>&1; then
    log "WARN: sha256sum not available; binary integrity NOT verified"
    return 0
  fi
  # A manifest that does not list the backend would "verify" a damaged or swapped binary:
  # sha256sum -c only checks the files it is told about (D4).
  if ! grep -Eq "[[:space:]]\*?(\./)?${_rel}\$" "${_m}" 2>/dev/null; then
    log "ERROR: ${_m} does not list ${_rel}; the binary cannot be verified. Refusing to start (rebuild and reinstall the package)"
    return 1
  fi
  if ! _out="$(cd "${BASE}/target" && sha256sum -c "${MANIFEST_NAME}" 2>&1)"; then
    log "ERROR: package integrity check FAILED against ${MANIFEST_NAME}; refusing to start:"
    echo "${_out}" | grep -v ': OK$' >> "${LOG}" 2>/dev/null || true
    return 1
  fi
  log "manifest verified ($(wc -l < "${_m}" | tr -d ' ') files)"
  return 0
}

# The backend runs with a normal umask (see start): it also writes into the user's media
# shares (normalized videos, backups), and those files must stay readable by other DSM
# users and apps. So owner-only is applied to the package's own files, by name, not by
# umask: create_private_files makes the DB and log 0600 from their first byte, SQLite gives
# -wal/-shm the mode of the DB file, and secure_existing_files tightens what a previous
# version created. A file we cannot chmod (owned by another user, typically root leftovers
# from a root-run start) is reported, not ignored.
# write_private <path> <content>: the file is born 0600 and any older, wider copy is replaced
# (redirecting into an existing file would keep its old mode).
write_private() {
  rm -f "$1" 2>/dev/null || true
  ( umask 077; printf '%s\n' "$2" > "$1" )
}

create_private_files() {
  for _f in "${DSVIDEO_DB_PATH}" "${LOG}"; do
    # umask 077 only inside this subshell; an existing file is left for secure_existing_files.
    [ -e "${_f}" ] || ( umask 077; : >> "${_f}" ) 2>/dev/null || log "WARN: cannot create ${_f}"
  done
}

secure_existing_files() {
  for _f in "${DSVIDEO_DB_PATH}" "${DSVIDEO_DB_PATH}-wal" "${DSVIDEO_DB_PATH}-shm" \
            "${DSVIDEO_DB_PATH}".pre-*.db "${LOG}" "${LOG}.1" "${VAR}/.jwt_secret" "${PIDFILE}" "${WATCHDOG_PIDFILE}"; do
    [ -f "${_f}" ] || continue
    chmod 600 "${_f}" 2>/dev/null || log "WARN: cannot chmod 600 ${_f} (not owned by uid ${SELF_UID}); fix as root"
  done
}

# Rotate the log before every start and cap it while running. The server appends
# to a single file forever via nohup; with no rotation this reached 345MB on the
# live NAS and would eventually fill the package volume. Keep one previous
# generation so a crash's context survives a restart.
LOG_MAX_BYTES=20971520   # 20MB
rotate_log() {
  [ -f "${LOG}" ] || return 0
  _sz="$(wc -c < "${LOG}" 2>/dev/null || echo 0)"
  if [ "${_sz}" -gt "${LOG_MAX_BYTES}" ]; then
    mv -f "${LOG}" "${LOG}.1" 2>/dev/null || true
    # The new log is created here at the caller's umask (022 in start): make it 0600 (D7).
    ( umask 077; : > "${LOG}" )
    echo "[${PACKAGE}] log rotated at ${_sz} bytes (previous kept as ${LOG}.1)" >> "${LOG}"
  fi
}

# ---------------------------------------------------------------------------------------
# Watchdog (log truncation) and child sweep
# ---------------------------------------------------------------------------------------

start_watchdog() {
  # The server holds ${LOG} open for append, so rotating out from under it would leak the
  # inode and stop reclaiming space. Truncate in place instead — append-mode writes
  # continue correctly against a truncated file.
  # The loop's pid is recorded so stop can end it; it traps TERM so its sleep dies with it.
  (
    # This subshell creates ${LOG}.1 with cp; it inherited start's umask 022 (D7).
    umask 077
    trap '[ -z "${_sp:-}" ] || signal_pid "${_sp}" TERM; exit 0' TERM
    while [ -f "${PIDFILE}" ] && pid_alive "$(cat "${PIDFILE}" 2>/dev/null || echo 0)"; do
      sleep 300 &
      _sp=$!
      wait "${_sp}" || true
      [ -f "${LOG}" ] || continue
      _sz="$(wc -c < "${LOG}" 2>/dev/null || echo 0)"
      if [ "${_sz}" -gt "${LOG_MAX_BYTES}" ]; then
        cp -f "${LOG}" "${LOG}.1" 2>/dev/null || true
        : > "${LOG}"
        echo "[${PACKAGE}] log truncated in place at ${_sz} bytes" >> "${LOG}"
      fi
    done
  ) >/dev/null 2>&1 &
  write_private "${WATCHDOG_PIDFILE}" "$!"
}

stop_watchdog() {
  [ -f "${WATCHDOG_PIDFILE}" ] || return 0
  _wd="$(cat "${WATCHDOG_PIDFILE}" 2>/dev/null || true)"
  # Guard against a recycled pid: the watchdog is a subshell of this very script, so its
  # command line names the script.
  case "${_wd}" in ''|*[!0-9]*) ;; *)
    if tr '\0' ' ' < "${PROC_ROOT}/${_wd}/cmdline" 2>/dev/null | grep -q 'start-stop-status'; then
      signal_pid "${_wd}" TERM || true
    fi
  ;; esac
  rm -f "${WATCHDOG_PIDFILE}"
}

# Pids whose parent is $1 (the backend's transcode and probe children).
children_of() {
  grep -l "^PPid:[[:space:]]*${1}\$" "${PROC_ROOT}"/[0-9]*/status 2>/dev/null \
    | sed 's#.*/\([0-9][0-9]*\)/status#\1#' || true
}

# Kills ffmpeg/ffprobe orphans left behind when the backend died. Only pids recorded as
# the backend's children BEFORE it was stopped are considered, and only if they are still
# ffmpeg/ffprobe, so a recycled pid is never hit.
sweep_children() {
  for _k in $1; do
    [ -d "${PROC_ROOT}/${_k}" ] || continue
    _kc="$(cat "${PROC_ROOT}/${_k}/comm" 2>/dev/null || true)"
    case "${_kc}" in
      ffmpeg|ffprobe)
        log "sweeping orphaned ${_kc} (pid ${_k}) left by the stopped backend"
        signal_pid "${_k}" TERM || true
        sleep 1
        [ ! -d "${PROC_ROOT}/${_k}" ] || signal_pid "${_k}" KILL || true
        ;;
    esac
  done
}

# ---------------------------------------------------------------------------------------
# start / stop / status
# ---------------------------------------------------------------------------------------

# Prints the pid in the pidfile if it names a live dsvideo-backend that runs as the package
# user. A dsvideo-backend of another uid (a root-run leftover, the original outage) is not
# ours: it is logged and ignored, never signalled. Returns 1 when there is nothing of ours.
owned_pidfile_pid() {
  [ -f "${PIDFILE}" ] || return 1
  _op="$(cat "${PIDFILE}" 2>/dev/null || true)"
  pid_alive "${_op}" || return 1
  if ! proc_owned_by_self "${_op}"; then
    log "WARN: ${PIDFILE} names pid ${_op}, a dsvideo-backend running as uid '$(proc_uids "${_op}")', not ours (${SELF_UID}); ignoring it and leaving it alone"
    return 1
  fi
  echo "${_op}"
}

start() {
  # NOT umask 077: the backend writes into the user's media shares (normalize/convert
  # outputs, backups, sidecar files), and a 0600 file there is unreadable to every other
  # DSM user and app. Pin the usual 022 so the result does not depend on what the caller
  # inherited; the package's private files are protected by name below instead.
  umask 022
  mkdir -p "${VAR}"

  # Default configuration (can be overridden by DSM package env/config files)
  export DSVIDEO_PORT="${PORT}"
  export DSVIDEO_BASE_URL="${DSVIDEO_BASE_URL:-}"
  export DSVIDEO_DB_PATH="${DSVIDEO_DB_PATH:-${VAR}/dsvideo.db}"

  create_private_files
  secure_existing_files
  rotate_log

  # NOTE: this script deliberately does NOT touch the live nginx conf.
  #
  # It used to cp the package's nginx/DSVideoServer.conf over
  # /etc/nginx/conf.d/dsm.pkg-static.DSVideoServer-2059624305.conf and reload nginx by
  # hand, as a "self-heal" against DSM regenerating the conf from a stale cache. Two
  # mechanisms were managing one file: conf/resource already registers the same conf
  # declaratively under web-config/nginx-static-config, and DSM's privileged resource
  # worker injects it on install (see postinst), while INFO's
  # instuninst_restart_services="nginx" and startstop_restart_services="nginx" make DSM
  # restart nginx on install/uninstall and on every package start/stop — which is exactly
  # what the hand-rolled reload was for.
  #
  # The cp was also pinned to that -2059624305 suffix, a DSM-internal hash. Nothing
  # guarantees it survives a repackage or a DSM upgrade: the day it stops matching, the
  # `[ -f "${NGINX_LIVE}" ]` guard silently turns the whole self-heal into a no-op, and if
  # it instead matched a conf DSM had legitimately regenerated we would clobber it. A
  # safety net that fails closed and silently is worse than no safety net, because the
  # logs keep saying the package started fine.
  #
  # If proxy routes ever go missing after a restart again, fix it in
  # spk/DSVideoServer/nginx/DSVideoServer.conf and reinstall — do not reintroduce a
  # second writer here.

  GO_BINARY="$(find_go_binary || true)"

  # Check for Go binary
  if [ -z "${GO_BINARY}" ]; then
    log "ERROR: Go binary not found."
    log "Expected (primary): ${BASE}/target/backend/dsvideo-backend"
    log "If you installed a gzipped/nested SPK, rebuild with spk/build-spk-macos.sh and reinstall."
    exit 1
  fi

  [ -n "${VERSION}" ] || log "WARN: could not read version from ${BASE}/INFO; healthz version is not checked"

  verify_manifest "${GO_BINARY#"${BASE}"/target/}" || exit 1

  # Already running: only if it is demonstrably this build, answering. A live pid that does
  # not answer (hung, wrong version) is stopped and replaced.
  if _running="$(owned_pidfile_pid)"; then
    if _why="$(health_probe "${_running}" 3s)"; then
      log "already running (pid ${_running}): ${_why}"
      exit 0
    fi
    log "pid ${_running} from the pidfile is alive but not healthy (${_why}); replacing it"
    terminate_pid "${_running}" 10 || { log "ERROR: pid ${_running} would not die"; exit 1; }
  fi
  rm -f "${PIDFILE}"

  # Port clearance. Our own stale backend is terminated; anything else fails the start.
  ensure_port_free || { log "ERROR: start aborted: port ${PORT} is not available"; exit 1; }

  # Generate JWT secret if not set - use /dev/urandom (no openssl dependency)
  if [ -z "${DSVIDEO_JWT_SECRET:-}" ]; then
    # Generate and persist the secret so it survives restarts
    SECRET_FILE="${VAR}/.jwt_secret"
    if [ -f "${SECRET_FILE}" ]; then
      DSVIDEO_JWT_SECRET="$(cat "${SECRET_FILE}")"
    else
      DSVIDEO_JWT_SECRET="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
      # Create with 600 already applied. Writing first and chmod'ing after leaves the
      # signing key world-readable at the default umask for the window in between.
      write_private "${SECRET_FILE}" "${DSVIDEO_JWT_SECRET}"
    fi
  fi
  export DSVIDEO_JWT_SECRET

  # Library roots should be configured by the admin post-install:
  export DSVIDEO_MOVIES_PATH="${DSVIDEO_MOVIES_PATH:-/volume1/video/Movies}"
  export DSVIDEO_TV_PATH="${DSVIDEO_TV_PATH:-/volume1/video/Shows}"

  # FFmpeg/FFprobe paths. TASK-750: prefer the ffmpeg we bundle in the package's
  # bin/ dir — it's built with --enable-vaapi (and QSV where available) so hardware
  # transcode and trick-play thumbnails can engage. The Synology system ffmpeg is
  # usually compiled without VAAPI, so we only fall back to it.
  # ff_works: true only if the binary both exists AND actually runs here. The bundled
  # ffmpeg is built against libva/libdrm which DSM may not ship in the default loader
  # path — if it can't load its libs, -version exits non-zero and we must skip it
  # rather than hand the server a binary that fails at transcode time.
  ff_works() { [ -x "$1" ] && "$1" -hide_banner -version >/dev/null 2>&1; }

  PKG_FFMPEG="${BASE}/target/bin/ffmpeg"
  PKG_FFPROBE="${BASE}/target/bin/ffprobe"
  if [ -z "${DSVIDEO_FFMPEG_PATH:-}" ]; then
    for ffpath in "$PKG_FFMPEG" /usr/bin/ffmpeg /var/packages/ffmpeg/target/bin/ffmpeg /volume1/@appstore/ffmpeg/bin/ffmpeg; do
      if ff_works "$ffpath"; then
        export DSVIDEO_FFMPEG_PATH="$ffpath"
        break
      fi
    done
  fi
  if [ -z "${DSVIDEO_FFPROBE_PATH:-}" ]; then
    for ffpath in "$PKG_FFPROBE" /usr/bin/ffprobe /var/packages/ffmpeg/target/bin/ffprobe /volume1/@appstore/ffmpeg/bin/ffprobe; do
      if ff_works "$ffpath"; then
        export DSVIDEO_FFPROBE_PATH="$ffpath"
        break
      fi
    done
  fi

  # TASK-750: hardware-accelerated transcode. "auto" lets the server probe the
  # ffmpeg above for h264_vaapi/h264_qsv and check the DRM render node — it silently
  # falls back to software if neither is usable, so this is safe on any NAS. The
  # render node is only present on Intel models with an iGPU.
  export DSVIDEO_HW_ACCEL="${DSVIDEO_HW_ACCEL:-auto}"
  if [ -z "${DSVIDEO_VAAPI_DEVICE:-}" ] && [ -e /dev/dri/renderD128 ]; then
    export DSVIDEO_VAAPI_DEVICE="/dev/dri/renderD128"
  fi

  # Transcode temporary directory (stored in package var for persistence/cleanup)
  export DSVIDEO_TRANSCODE_DIR="${DSVIDEO_TRANSCODE_DIR:-${VAR}/transcode}"
  mkdir -p "${DSVIDEO_TRANSCODE_DIR}"

  # TASK-755 auto-normalize: background conversion of non-DirectPlay files.
  # MAX_HEIGHT is pinned here as well as defaulted in the binary because this cap is a
  # PERMANENT downscale — normalization replaces the original and the reaper deletes the
  # backup after RETENTION_DAYS. 1080 keeps 1080p sources intact; 720 would destroy them.
  export DSVIDEO_NORMALIZE_MAX_HEIGHT="${DSVIDEO_NORMALIZE_MAX_HEIGHT:-1080}"

  # TMDb API key for metadata fetching (optional but recommended)
  # Get your free API key at: https://www.themoviedb.org/settings/api
  export DSVIDEO_TMDB_API_KEY="${DSVIDEO_TMDB_API_KEY:-}"

  # Image cache directory
  export DSVIDEO_IMAGE_CACHE_DIR="${DSVIDEO_IMAGE_CACHE_DIR:-${VAR}/images}"
  mkdir -p "${DSVIDEO_IMAGE_CACHE_DIR}"

  log "Starting ${GO_BINARY} (version ${VERSION:-unknown}, uid ${SELF_UID}) with port=${DSVIDEO_PORT} db=${DSVIDEO_DB_PATH}"
  log "Movies=${DSVIDEO_MOVIES_PATH} TV=${DSVIDEO_TV_PATH}"

  # Launch in a process group of its own (setsid), so a failed gate can kill the child and
  # everything it spawned in one signal (D2). busybox sh cannot do this with "set -m" (no
  # controlling tty under DSM: "job control turned off"), so setsid it is; without it the
  # child is still killed by pid, which is enough for a child that has not exec'd yet.
  if command -v setsid >/dev/null 2>&1; then
    setsid nohup "${GO_BINARY}" >> "${LOG}" 2>&1 < /dev/null &
  else
    log "WARN: setsid not available; the backend shares this script's process group"
    nohup "${GO_BINARY}" >> "${LOG}" 2>&1 < /dev/null &
  fi
  CHILD=$!
  log "launched pid ${CHILD}; waiting up to ${START_TIMEOUT}s for /api/v1/healthz to confirm it"

  # The gate. The start is reported successful only when healthz on the port answers with
  # THIS pid, THIS uid and THIS version. Otherwise the child is killed so a half-started
  # server cannot linger, and the start fails.
  if ! wait_healthy "${CHILD}" "${START_TIMEOUT}"; then
    # "group": the child may be anywhere between fork and exec, so liveness is "exists", not
    # "is a dsvideo-backend", and its process group goes with it. Otherwise the backend execs
    # a moment later and holds the port with no pidfile (D2).
    terminate_pid "${CHILD}" 5 group || log "ERROR: launched pid ${CHILD} would not die; it may still hold port ${PORT}"
    rm -f "${PIDFILE}"
    log "ERROR: start FAILED"
    exit 1
  fi

  # Pidfile only after the gate: a pidfile never names a process we have not confirmed.
  write_private "${PIDFILE}" "${CHILD}"
  start_watchdog
  log "started (pid ${CHILD})"
}

stop() {
  _rc=0
  _kids=""

  if PID="$(owned_pidfile_pid)"; then
    _kids="$(children_of "${PID}")"
    log "stopping pid ${PID} (TERM, then KILL after 10s)"
    # Wait for the process to actually exit. Without this, rapid package upgrades fail
    # with "address already in use" because the new binary binds while the old one dies.
    terminate_pid "${PID}" 10 || { log "ERROR: pid ${PID} could not be stopped"; _rc=1; }
  fi

  # Verify the port is free. A backend of ours that is NOT in the pidfile (lost pidfile,
  # interrupted start) is a leftover: terminate it too. A foreign holder is reported only.
  classify_port_holder || true
  case "${HOLDER_STATE}" in
    ours)
      _kids="${_kids} $(children_of "${HOLDER_PID}")"
      log "port ${PORT} still held by a backend of ours not in the pidfile ($(describe_holder)); terminating"
      terminate_pid "${HOLDER_PID}" 10 || { log "ERROR: pid ${HOLDER_PID} could not be stopped"; _rc=1; }
      ;;
    foreign)
      log "WARN: port ${PORT} is held by a process that is not ours; leaving it alone: $(describe_holder)"
      ;;
  esac

  stop_watchdog
  sweep_children "${_kids}"
  rm -f "${PIDFILE}"

  if wait_port_free 3; then
    log "stopped (port ${PORT} is free)"
  elif [ "${HOLDER_STATE}" = "foreign" ]; then
    log "stopped our backend; port ${PORT} remains held by a foreign process"
  else
    log "ERROR: stop finished but port ${PORT} is still held by ours: $(describe_holder)"
    _rc=1
  fi
  exit "${_rc}"
}

# Exit 0 only when the pid in the pidfile is our backend AND it answers healthz as itself.
# A hung or wrong-build process reports "not running" instead of looking healthy.
status() {
  [ -f "${PIDFILE}" ] || exit 1
  PID="$(cat "${PIDFILE}" 2>/dev/null || true)"
  pid_alive "${PID}" || exit 1
  GO_BINARY="$(find_go_binary || true)"
  [ -n "${GO_BINARY}" ] || exit 1
  if health_probe "${PID}" 5s >/dev/null 2>&1; then
    exit 0
  fi
  exit 1
}

# spk/tests sources this file to exercise the functions above without running a command.
if [ "${DSVIDEO_SSS_SOURCE_ONLY:-}" != "1" ]; then
  case "${1:-}" in
    start) start ;;
    stop) stop ;;
    status) status ;;
    *) echo "usage: $0 {start|stop|status}" ; exit 2 ;;
  esac
fi
