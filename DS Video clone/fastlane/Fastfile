require 'json'

default_platform(:ios)

# iOS bundle ID
IOS_BUNDLE_ID  = "HeiloProjects.DSReel"
# tvOS bundle ID (same app as iOS in ASC — platform param distinguishes it)
TVOS_BUNDLE_ID = "HeiloProjects.DSReel"

def api_key
  config = JSON.parse(File.read(File.expand_path("~/.appstoreconnect/config.json")))
  app_store_connect_api_key(
    key_id:        config["keyId"],
    issuer_id:     config["issuerId"],
    key_filepath:  File.expand_path(config["privateKeyPath"])
  )
end

# ──────────────────────────────────────────────────────
# iOS lanes
# ──────────────────────────────────────────────────────
platform :ios do

  # Upload iOS metadata only (no binary, no screenshots)
  lane :upload_metadata do
    deliver(
      api_key:             api_key,
      app_identifier:      IOS_BUNDLE_ID,
      metadata_path:       "metadata/ios",
      skip_binary_upload:  true,
      skip_screenshots:    true,
      force:               true,
      run_precheck_before_submit: false,
      app_review_information: {
        first_name:    File.read("metadata/ios/en-US/review_information/first_name.txt").strip,
        last_name:     File.read("metadata/ios/en-US/review_information/last_name.txt").strip,
        phone_number:  File.read("metadata/ios/en-US/review_information/phone_number.txt").strip,
        email_address: File.read("metadata/ios/en-US/review_information/email_address.txt").strip,
        notes:         File.read("metadata/ios/en-US/review_information/notes.txt").strip
      }
    )
  end

  # Archive the Release build and upload the binary to App Store Connect / TestFlight.
  # The metadata/submit lanes use skip_binary_upload, so this lane is what actually
  # gets the .ipa to ASC. Version/build come from the project (currently 1.3.0 / 1).
  lane :build_and_upload do
    # The "DSM Video" iOS scheme is now SHARED (xcshareddata/xcschemes/DSM Video.xcscheme)
    # pointing at the iOS app target. Previously it was an implicit user scheme fastlane
    # couldn't see, so fastlane silently fell back to the only shared scheme — the tvOS
    # one — and produced "DSM Video tvOS.app" at 1.3.2 (a closed ASC train). With the
    # shared iOS scheme, this archives the iOS app target (HeiloProjects.DSReel, 1.3.0).
    build_app(
      project:        "DSM Video.xcodeproj",
      scheme:         "DSM Video",
      configuration:  "Release",
      export_method:  "app-store",
      clean:          true,
      output_directory: "build",
      output_name:    "DSM Video.ipa",
      xcargs:         "-allowProvisioningUpdates"
    )
    upload_to_testflight(
      api_key:             api_key,
      app_identifier:      IOS_BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      skip_submission:     true
    )
  end

  # Submit existing iOS build for review
  lane :submit do
    deliver(
      api_key:             api_key,
      app_identifier:      IOS_BUNDLE_ID,
      app_version:         "1.3.3",
      build_number:        "1",
      metadata_path:       "metadata/ios",
      skip_binary_upload:  true,
      skip_screenshots:    true,
      skip_metadata:       true,
      submit_for_review:   true,
      automatic_release:   true,
      force:               true,
      run_precheck_before_submit: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa:             false
      }
    )
  end

end

# ──────────────────────────────────────────────────────
# tvOS lanes (run under ios platform — fastlane doesn't
# officially support :appletvos; platform param on deliver
# handles the distinction)
# ──────────────────────────────────────────────────────
platform :ios do

  lane :upload_metadata_tvos do
    deliver(
      api_key:             api_key,
      app_identifier:      TVOS_BUNDLE_ID,
      app_version:         "1.3.3",
      metadata_path:       "metadata/tvos",
      platform:            "appletvos",
      skip_binary_upload:  true,
      skip_screenshots:    true,
      force:               true,
      run_precheck_before_submit: false,
      app_review_information: {
        first_name:    File.read("metadata/tvos/en-US/review_information/first_name.txt").strip,
        last_name:     File.read("metadata/tvos/en-US/review_information/last_name.txt").strip,
        phone_number:  File.read("metadata/tvos/en-US/review_information/phone_number.txt").strip,
        email_address: File.read("metadata/tvos/en-US/review_information/email_address.txt").strip,
        notes:         File.read("metadata/tvos/en-US/review_information/notes.txt").strip
      }
    )
  end

  lane :submit_tvos do
    deliver(
      api_key:             api_key,
      app_identifier:      TVOS_BUNDLE_ID,
      app_version:         "1.3.3",
      build_number:        "1",
      metadata_path:       "metadata/tvos",
      platform:            "appletvos",
      skip_binary_upload:  true,
      skip_screenshots:    true,
      skip_metadata:       true,
      submit_for_review:   true,
      automatic_release:   true,
      force:               true,
      run_precheck_before_submit: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa:             false
      }
    )
  end

end

platform :ios do
  lane :verify_build do
    n = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: IOS_BUNDLE_ID,
      version: "1.3.0"
    )
    UI.message("LATEST_1_3_0_BUILD=#{n}")
  end
end

platform :ios do
  lane :upload_existing_ipa do
    upload_to_testflight(
      api_key: api_key,
      app_identifier: IOS_BUNDLE_ID,
      ipa: "build/DSM Video.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
    UI.success("UPLOAD_LANE_DONE")
  end
end

platform :ios do
  lane :list_builds do
    require 'spaceship'
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: JSON.parse(File.read(File.expand_path("~/.appstoreconnect/config.json")))["keyId"],
      issuer_id: JSON.parse(File.read(File.expand_path("~/.appstoreconnect/config.json")))["issuerId"],
      filepath: File.expand_path(JSON.parse(File.read(File.expand_path("~/.appstoreconnect/config.json")))["privateKeyPath"])
    )
    app = Spaceship::ConnectAPI::App.find(IOS_BUNDLE_ID)
    builds = app.get_builds(includes: "preReleaseVersion", limit: 8)
    builds.each do |b|
      v = b.pre_release_version&.version
      UI.message("BUILD ver=#{v} build=#{b.version} state=#{b.processing_state} uploaded=#{b.uploaded_date}")
    end
  end
end

platform :ios do
  lane :asc_state do
    require 'spaceship'
    cfg = JSON.parse(File.read(File.expand_path("~/.appstoreconnect/config.json")))
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: cfg["keyId"], issuer_id: cfg["issuerId"],
      filepath: File.expand_path(cfg["privateKeyPath"]))
    app = Spaceship::ConnectAPI::App.find(IOS_BUNDLE_ID)
    UI.message("=== LIVE / EDIT versions ===")
    app.get_app_store_versions(includes: "build", limit: 10).each do |v|
      UI.message("APPSTORE ver=#{v.version_string} state=#{v.app_store_state} platform=#{v.platform}")
    end
  end
end

platform :ios do
  # Create (if needed) the 1.3.3 App Store version record and push its metadata.
  # The binary upload does NOT create the store-version record; deliver must, or
  # metadata push fails with "Cannot find edit app store version".
  lane :create_version_and_metadata do
    deliver(
      api_key:             api_key,
      app_identifier:      IOS_BUNDLE_ID,
      app_version:         "1.3.3",
      metadata_path:       "metadata/ios",
      skip_binary_upload:  true,
      skip_screenshots:    true,
      force:               true,
      run_precheck_before_submit: false
    )
  end
end

platform :ios do
  lane :readiness do
    require 'spaceship'
    cfg = JSON.parse(File.read(File.expand_path("~/.appstoreconnect/config.json")))
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(key_id: cfg["keyId"], issuer_id: cfg["issuerId"], filepath: File.expand_path(cfg["privateKeyPath"]))
    app = Spaceship::ConnectAPI::App.find(IOS_BUNDLE_ID)
    v = app.get_app_store_versions(filter: {versionString: "1.3.3"}, includes: "build").first
    UI.message("VERSION 1.3.3 state=#{v&.app_store_state}")
    b = v&.build
    UI.message("BUILD attached=#{b ? "#{b.version} (#{b.processing_state})" : "NONE"}")
    UI.message("releaseNotes_set=#{!v&.release_notes.to_s.empty? rescue 'n/a'}")
  end
end

platform :ios do
  # Attach the VALID 1.3.3 build to the 1.3.3 App Store version. Uploading a build
  # and creating a version don't auto-link them — the version shows "no build" and
  # submission is blocked until the build is selected.
  lane :attach_build do
    require 'spaceship'
    cfg = JSON.parse(File.read(File.expand_path("~/.appstoreconnect/config.json")))
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(key_id: cfg["keyId"], issuer_id: cfg["issuerId"], filepath: File.expand_path(cfg["privateKeyPath"]))
    app = Spaceship::ConnectAPI::App.find(IOS_BUNDLE_ID)
    version = app.get_app_store_versions(filter: {versionString: "1.3.3"}).first
    build = app.get_builds(includes: "preReleaseVersion").find { |b| b.pre_release_version&.version == "1.3.3" && b.processing_state == "VALID" }
    if build.nil?
      UI.user_error!("No VALID 1.3.3 build found to attach")
    end
    version.select_build(build_id: build.id)
    UI.success("ATTACHED build #{build.version} to version 1.3.3")
  end
end

platform :ios do
  lane :readiness2 do
    require 'spaceship'
    cfg = JSON.parse(File.read(File.expand_path("~/.appstoreconnect/config.json")))
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(key_id: cfg["keyId"], issuer_id: cfg["issuerId"], filepath: File.expand_path(cfg["privateKeyPath"]))
    app = Spaceship::ConnectAPI::App.find(IOS_BUNDLE_ID)
    v = app.get_app_store_versions(filter: {versionString: "1.3.3"}, includes: "build").first
    UI.message("state=#{v&.app_store_state}")
    UI.message("build=#{v&.build ? "#{v.build.version} (#{v.build.processing_state})" : "NONE"}")
  end
end

platform :ios do
  lane :final_checklist do
    require 'spaceship'
    cfg = JSON.parse(File.read(File.expand_path("~/.appstoreconnect/config.json")))
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(key_id: cfg["keyId"], issuer_id: cfg["issuerId"], filepath: File.expand_path(cfg["privateKeyPath"]))
    app = Spaceship::ConnectAPI::App.find(IOS_BUNDLE_ID)
    # Age rating
    begin
      info = app.fetch_app_info rescue nil
      UI.message("APP name=#{app.name} sku=#{app.sku}")
    rescue => e
      UI.message("appinfo err=#{e.message}")
    end
    v = app.get_app_store_versions(filter: {versionString: "1.3.3"}, includes: "build").first
    UI.message("VERSION state=#{v&.app_store_state} build=#{v&.build&.version} releaseType=#{v&.release_type}")
  end
end
