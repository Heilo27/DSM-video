require 'json'

default_platform(:ios)

# ──────────────────────────────────────────────────────
# Release version — SINGLE SOURCE OF TRUTH.
# Must match MARKETING_VERSION in DSM Video.xcodeproj.
# Bump here and in Xcode together, or run `fastlane bump version:X.Y.Z`
# which updates both.
#
# NOTE: 1.3.6 is READY_FOR_SALE on BOTH platforms as of 2026-09-20. ASC will not
# let you re-create an existing version record, and this comment goes stale the
# moment a release ships — run `fastlane asc_state` before choosing a number
# rather than trusting what is written here.
# ──────────────────────────────────────────────────────
VERSION = "1.3.9"

# iOS bundle ID
IOS_BUNDLE_ID  = "HeiloProjects.DSReel"
# Continue Watching widget extension (iOS only, TASK-743). Embedded in the iPhone app.
WIDGET_BUNDLE_ID = "HeiloProjects.DSReel.widget"
# App Group shared by the iPhone app, its widget, the tvOS app and Top Shelf.
APP_GROUP_ID = "group.HeiloProjects.DSReel"
# tvOS bundle ID (same app as iOS in ASC — platform param distinguishes it)
TVOS_BUNDLE_ID = "HeiloProjects.DSReel"

# Xcode schemes (both are SHARED — see xcshareddata/xcschemes/)
IOS_SCHEME  = "DSM Video"
TVOS_SCHEME = "DS Video clone tvOS"

# fastlane runs lanes with CWD set to the fastlane/ directory, so every path to
# project files must be anchored to the repo root explicitly.
ROOT      = File.expand_path("..", __dir__)
XCODEPROJ = File.join(ROOT, "DSM Video.xcodeproj")

# Apple Developer Team ID (from DEVELOPMENT_TEAM in the Xcode project)
TEAM_ID   = "752QKBCTJR"

def api_key
  config_path = File.expand_path("~/.appstoreconnect/config.json")
  unless File.exist?(config_path)
    UI.user_error!(
      "Missing ~/.appstoreconnect/config.json.\n" \
      "This machine has not been set up for ASC uploads. See fastlane/README.md " \
      "— you need config.json plus the AuthKey_*.p8 private key. Neither is in " \
      "git (they are secrets); copy them from the machine that already works."
    )
  end
  config = JSON.parse(File.read(config_path))
  key_path = File.expand_path(config["privateKeyPath"])
  unless File.exist?(key_path)
    UI.user_error!("ASC private key not found at #{key_path} (from config.json privateKeyPath).")
  end
  app_store_connect_api_key(
    key_id:        config["keyId"],
    issuer_id:     config["issuerId"],
    key_filepath:  key_path
  )
end

# Guard against submitting from a beta/mismatched Xcode. Beta Xcode builds to a
# device fine but fails archive-submit with INVALID_BINARY — a failure that only
# surfaces after a full archive+upload cycle. Fail fast instead.
def check_xcode
  out       = `xcodebuild -version 2>/dev/null`
  ver       = out.lines[0].to_s.strip                       # "Xcode 27.0"
  build_num = out.lines[1].to_s.strip.sub("Build version ", "") # "27A5194q"
  dev_path  = `xcode-select -p 2>/dev/null`.strip
  UI.message("#{ver} (#{build_num}) at #{dev_path}")

  # Beta signals. Any one means App Store Connect will reject the archive with
  # INVALID_BINARY *after* a full archive+upload cycle — so fail here instead,
  # where it costs seconds rather than half an hour.
  #   1. version string literally says beta
  #   2. the active developer dir is an Xcode-beta.app
  #   3. no Mac App Store receipt — betas are portal downloads, releases are not
  #
  # THE TRAILING-LETTER RULE WAS REMOVED. It read "GM/release builds end in a
  # digit, e.g. 16C5032a is beta" — but 16C5032a WAS the Xcode 16.2 release, so
  # the rule was wrong the day it was written. It went unnoticed because no
  # release build tripped it until Xcode 27.0 (build 27A266a, released
  # 2026-09-14), at which point this guard blocked every legitimate submission
  # and told the user to go install the Xcode they already had.
  #
  # The MAS receipt is the signal that actually separates the two: Apple ships
  # betas from the developer portal as Xcode-beta.app with no receipt, and
  # releases through the App Store with one. A release Xcode downloaded directly
  # from the portal also has no receipt — hence `warn`, not `fail`, for that one
  # alone: it is evidence, not proof, and refusing to build on it would repeat
  # the mistake this comment exists to record.
  mas_receipt = File.exist?(File.join(dev_path.sub(%r{/Contents/Developer\z}, ""),
                                      "Contents/_MASReceipt/receipt"))

  reasons = []
  reasons << "version string says beta"    if ver.downcase.include?("beta")
  reasons << "active Xcode is #{dev_path}" if dev_path.downcase.include?("beta")

  unless reasons.empty?
    UI.user_error!(
      "BETA XCODE DETECTED — App Store Connect will reject this archive with " \
      "INVALID_BINARY.\n" \
      "Signals: #{reasons.join('; ')}\n\n" \
      "Fix: install a release Xcode from the App Store, then point at it:\n" \
      "  sudo xcode-select -s /Applications/Xcode.app\n" \
      "Verify with: xcodebuild -version\n\n" \
      "To build locally anyway (NOT for submission), set ALLOW_BETA_XCODE=1."
    ) unless ENV["ALLOW_BETA_XCODE"] == "1"
    UI.important("ALLOW_BETA_XCODE=1 set — continuing despite: #{reasons.join('; ')}")
  end

  unless mas_receipt
    UI.important(
      "This Xcode has no Mac App Store receipt, so it was not installed from the " \
      "App Store. That is expected for a portal download and is NOT by itself a " \
      "beta — but if the upload comes back INVALID_BINARY, read the App Store " \
      "Connect red box: it is the only place the real reason appears."
    )
  end
  ver
end

# Verify the Xcode project's MARKETING_VERSION matches VERSION above, so the
# binary you upload and the ASC version record you push metadata to agree.
def check_version_match
  pbx = File.read("#{XCODEPROJ}/project.pbxproj")
  found = pbx.scan(/MARKETING_VERSION = ([0-9.]+);/).flatten.uniq
  if found.empty?
    UI.important("Could not read MARKETING_VERSION from project — skipping check.")
    return
  end
  unless found == [VERSION]
    UI.user_error!(
      "Version mismatch: Fastfile VERSION=#{VERSION} but project MARKETING_VERSION=" \
      "#{found.join(', ')}.\nRun: fastlane bump version:#{VERSION}"
    )
  end
  UI.success("Version check OK — #{VERSION} in both Fastfile and Xcode project.")
end

# ──────────────────────────────────────────────────────
# Version management
# ──────────────────────────────────────────────────────
platform :ios do

  # Bump MARKETING_VERSION across every target in the Xcode project AND report
  # the Fastfile constant that must be edited to match.
  #   fastlane bump version:1.3.6
  lane :bump do |options|
    v = options[:version]
    UI.user_error!("Usage: fastlane bump version:X.Y.Z") if v.to_s.empty?
    unless v =~ /\A\d+\.\d+(\.\d+)?\z/
      UI.user_error!("Version must look like 1.3.6, got '#{v}'")
    end
    path = "#{XCODEPROJ}/project.pbxproj"
    body = File.read(path)
    updated = body.gsub(/MARKETING_VERSION = [0-9.]+;/, "MARKETING_VERSION = #{v};")
    File.write(path, updated)
    UI.success("Set MARKETING_VERSION = #{v} in all targets.")
    UI.important("Now edit fastlane/Fastfile:  VERSION = \"#{v}\"")
  end

  # Set the build number (CFBundleVersion) across all targets.
  #   fastlane set_build build:2
  lane :set_build do |options|
    b = options[:build]
    UI.user_error!("Usage: fastlane set_build build:N") if b.to_s.empty?
    UI.user_error!("build must be a positive integer, got '#{b}'") unless b.to_s =~ /\A[1-9][0-9]*\z/
    write_project_build_number(b)
    UI.success("Set CURRENT_PROJECT_VERSION = #{b} in all targets.")
  end

  # Print everything a fresh machine needs to confirm before submitting.
  lane :doctor do
    # Report-only: doctor must never abort, it exists to show you the whole picture.
    begin
      check_xcode
    rescue => e
      UI.error("XCODE: #{e.message.lines.first.to_s.strip}")
    end
    UI.message("Fastfile VERSION = #{VERSION}")
    pbx = File.read("#{XCODEPROJ}/project.pbxproj")
    UI.message("Project MARKETING_VERSION = #{pbx.scan(/MARKETING_VERSION = ([0-9.]+);/).flatten.uniq.join(', ')}")
    UI.message("Project CURRENT_PROJECT_VERSION = #{pbx.scan(/CURRENT_PROJECT_VERSION = ([0-9]+);/).flatten.uniq.join(', ')}")
    cfg = File.expand_path("~/.appstoreconnect/config.json")
    UI.message("ASC config: #{File.exist?(cfg) ? 'PRESENT' : 'MISSING — see fastlane/README.md'}")
    if File.exist?(cfg)
      kp = File.expand_path(JSON.parse(File.read(cfg))["privateKeyPath"])
      UI.message("ASC key:    #{File.exist?(kp) ? 'PRESENT' : "MISSING at #{kp}"}")
    end
    %W[#{XCODEPROJ}/xcshareddata/xcschemes/#{IOS_SCHEME}.xcscheme
       #{XCODEPROJ}/xcshareddata/xcschemes/#{TVOS_SCHEME}.xcscheme].each do |s|
      UI.message("Scheme #{File.basename(s)}: #{File.exist?(s) ? 'SHARED OK' : 'MISSING'}")
    end
  end

  # Run the full test suite — unit AND UI — on a simulator.
  #
  # The UI suite is not optional garnish. Until 2026-09-11 the UI-test target was Xcode's
  # untouched template (two stubs asserting nothing) AND its TEST_TARGET_NAME still pointed at
  # "DS Video clone", a target renamed long ago — so it could not have run even if asked. Two
  # P0s shipped through that hole: every download wrote a 22-byte HTTP error body to disk as
  # the .mp4 and marked the item downloaded, and the player's error screen rendered perfectly
  # with Retry, Dismiss and swipe all inert. Both are caught by tapping a control and asserting
  # an outcome.
  #
  # `device:` is overridable because the simulator lineup changes with every Xcode release and a
  # hardcoded name turns into a confusing "device not found" a year later.
  lane :test do |options|
    device = options[:device] || "iPhone 17"
    only_ui = options[:ui_only]
    suites = only_ui ? ["DSM VideoUITests"] : ["DSM VideoTests", "DSM VideoUITests"]

    suites.each do |suite|
      UI.message("── running #{suite} on #{device} ──")
      scan(
        project: XCODEPROJ,
        scheme: IOS_SCHEME,
        device: device,
        only_testing: [suite],
        clean: false,
        # The run must FAIL the lane. A test gate that reports and continues is decoration.
        fail_build: true
      )
    end
    UI.success("All suites passed on #{device}.")
  end

  # Guard the tvOS focus invariant. Kept separate from `test` because it is a static check that
  # needs no simulator, and because the bug it guards has now recurred FIVE times — most
  # recently in ItemDetailView, a view the script did not originally cover.
  lane :check_focus do
    sh("bash '#{File.expand_path("../../scripts/check-tvos-focus.sh", __dir__)}'")
  end

  # Prove the suite can FAIL. Breaks one behavior at a time and checks that a test notices.
  #
  # Why this is a gate and not a report: on 2026-09-12 a retrofit found 9 of 13 mutations
  # surviving a GREEN 105-test suite — 87% of the destructive surface unprotected, including
  # the two P0s fixed the day before. A suite that has never been proven capable of going red
  # tells you nothing. See docs/retrofit/R6-final.md.
  #
  # Slow by nature (~30s per mutation, 13 mutations). Run it before a release, not per commit.
  lane :mutation_gate do
    sh("python3 '#{File.expand_path("../../scripts/mutation-gate.py", __dir__)}'")
  end

  # Everything that must hold before an upload: focus guard, full suite, mutation gate.
  lane :preflight do
    check_focus
    test
    mutation_gate
    UI.success("Preflight passed — focus guard, suites, and mutation gate all green.")
  end

end

# ──────────────────────────────────────────────────────
# iOS lanes
# ──────────────────────────────────────────────────────
platform :ios do

  # Upload iOS metadata only (no binary, no screenshots)
  lane :upload_metadata do
    deliver(
      api_key:             api_key,
      app_identifier:      IOS_BUNDLE_ID,
      app_version:         VERSION,
      metadata_path:       "metadata/ios",
      skip_binary_upload:  true,
      skip_screenshots:    true,
      force:               true,
      run_precheck_before_submit: false,
      app_review_information: {
        first_name:    File.read("metadata/ios/en-US/review_information/first_name.txt").strip,
        last_name:     File.read("metadata/ios/en-US/review_information/last_name.txt").strip,
        phone_number:  File.read("metadata/ios/en-US/review_information/phone_number.txt").strip,
        email_address: File.read("metadata/ios/en-US/review_information/email_address.txt").strip,
        notes:         File.read("metadata/ios/en-US/review_information/notes.txt").strip
      }
    )
  end

  # Fetch the iOS App Store profile via the API key.
  #
  # Xcode on this machine has no signed-in Apple ID ("No Accounts"), so
  # -allowProvisioningUpdates cannot create a distribution profile on demand — the archive
  # succeeds and exportArchive then fails with "No profiles for 'HeiloProjects.DSReel' were
  # found", after the slow part is already done. Only a development "iOS Team Provisioning
  # Profile" was installed locally; App Store export needs a distribution one.
  #
  # tvOS already solved this (fetch_profiles_tvos); iOS simply never had the equivalent.
  lane :fetch_profiles_ios do |options|
    # App AND widget extension (TASK-743), like fetch_profiles_tvos does for app + Top Shelf.
    # Default export type is App Store; pass development:true for the development profiles.
    [IOS_BUNDLE_ID, WIDGET_BUNDLE_ID].each do |bundle|
      UI.message("Fetching iOS #{options[:development] ? 'development' : 'App Store'} profile for #{bundle}")
      sigh(
        api_key:        api_key,
        app_identifier: bundle,
        platform:       "ios",
        development:    options[:development] ? true : false,
        force:          options[:force] ? true : false
      )
    end
    UI.success("iOS provisioning profiles installed.")
  end

  # Register the Continue Watching widget App ID on the developer portal and enable the
  # App Groups capability. No App Store Connect record (the equivalent of produce's
  # skip_itc: true). Idempotent: an existing App ID / capability is reused.
  #
  # Uses Spaceship's ConnectAPI directly rather than the `produce` action: produce has no
  # api_key option (it needs an Apple ID session, and this machine has "No Accounts"),
  # so it cannot run unattended here.
  #
  # LIMITATION: the ASC API can enable the APP_GROUPS capability but has no endpoint to
  # assign a specific group identifier to an App ID. Run check_capabilities, then fetch
  # profiles with force:true and read the entitlements out of the profile to see whether
  # group.HeiloProjects.DSReel is carried. If it is not, assign the group once in the
  # developer portal UI (Identifiers > the App ID > App Groups > Configure).
  lane :produce_widget do
    asc_token
    b = Spaceship::ConnectAPI::BundleId.all.find { |x| x.identifier == WIDGET_BUNDLE_ID }
    if b.nil?
      b = Spaceship::ConnectAPI::BundleId.create(name: "DS Video Widget", platform: "IOS", identifier: WIDGET_BUNDLE_ID)
      UI.success("Created App ID #{WIDGET_BUNDLE_ID} (portal id #{b.id})")
    else
      UI.message("App ID #{WIDGET_BUNDLE_ID} already exists (portal id #{b.id})")
    end
    unless b.get_capabilities.map(&:capability_type).include?("APP_GROUPS")
      b.create_capability("APP_GROUPS")
      UI.success("Enabled APP_GROUPS on #{WIDGET_BUNDLE_ID}")
    end
  end

  # Archive the Release build and upload the binary to App Store Connect / TestFlight.
  # The metadata/submit lanes use skip_binary_upload, so this lane is what actually
  # gets the .ipa to ASC.
  lane :build_and_upload do
    check_xcode
    check_version_match
    ensure_fresh_build_number("IOS")

    # Provisioning must be fetched BEFORE export — see fetch_profiles_ios for why the
    # archive can succeed while the export fails.
    fetch_profiles_ios(force: true)
    # The "DSM Video" iOS scheme is SHARED (xcshareddata/xcschemes/DSM Video.xcscheme)
    # pointing at the iOS app target. Previously it was an implicit user scheme fastlane
    # couldn't see, so fastlane silently fell back to the only shared scheme — the tvOS
    # one — and produced "DSM Video tvOS.app" against a closed ASC train.
    build_app(
      project:        XCODEPROJ,
      scheme:         IOS_SCHEME,
      configuration:  "Release",
      export_method:  "app-store",
      clean:          true,
      output_directory: File.join(ROOT, "build"),
      output_name:    "DSM Video.ipa",
      xcargs:         "-allowProvisioningUpdates"
    )
    upload_to_testflight(
      api_key:             api_key,
      app_identifier:      IOS_BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      skip_submission:     true
    )
  end

  # Submit existing iOS build for review
  lane :submit do
    # What's New + promo text are written through the ASC API and read back; the lane
    # aborts here, BEFORE anything is submitted, if either is empty or differs from
    # metadata/ios/en-US. deliver is then told to skip metadata so it cannot blank them
    # between the verify and the submit (it did, non-deterministically, on 1.3.6/1.3.8).
    # The rest of the metadata is pushed by upload_metadata, which `release` runs first.
    push_store_text("IOS")
    verify_store_text("IOS")
    deliver(
      api_key:             api_key,
      app_identifier:      IOS_BUNDLE_ID,
      app_version:         VERSION,
      metadata_path:       "metadata/ios",
      skip_binary_upload:  true,
      skip_screenshots:    true,
      # skip_metadata is true ONLY because push_store_text + verify_store_text just
      # wrote and read back What's New + promo text above. The old skip_metadata:true
      # silently shipped blank/stale What's New with NO such check; do not remove the
      # check above. Build number omitted: deliver keeps the build already attached
      # (use attach_build build:N to choose it).
      skip_metadata:       true,
      submit_for_review:   true,
      automatic_release:   true,
      force:               true,
      run_precheck_before_submit: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa:             false
      }
    )
  end

  # One-shot: upload What's New + promo text + all metadata, THEN submit.
  # Use this for releases so metadata can never be skipped by accident.
  lane :release do
    upload_metadata
    submit
  end

  # Full iOS pipeline from a clean checkout: archive → upload → metadata → submit.
  lane :ship_ios do
    build_and_upload
    UI.important("Binary uploaded. Waiting for ASC processing before submit...")
    wait_for_processing(platform_name: "IOS")
    release
  end

end

# ──────────────────────────────────────────────────────
# tvOS lanes (run under ios platform — fastlane doesn't
# officially support :appletvos; platform param on deliver
# handles the distinction)
# ──────────────────────────────────────────────────────
platform :ios do

  # Fetch (or create) the App Store provisioning profiles for the tvOS app AND its
  # Top Shelf extension via the ASC API key, then install them locally.
  #
  # Why this exists: the tvOS targets use MANUAL signing with named profiles
  # ("DSM Video tvOS App Store v2", "DSM Video Shelf"). Those profiles are signing
  # assets tied to the Apple account — they are NOT in git and cannot be. On a
  # fresh machine, `archive` succeeds but `exportArchive` fails with
  #   "requires a provisioning profile with the App Groups feature"
  # Switching to automatic signing does not help either, because a machine with no
  # Xcode Apple ID reports "No Accounts". The API key is the only path that works
  # unattended, so fetch the profiles explicitly before exporting.
  # Pass force:true to REGENERATE profiles rather than reuse cached ones:
  #   fastlane fetch_profiles_tvos force:true
  # Needed when an App ID gained a capability (e.g. App Groups) after the existing
  # profile was issued — a stale profile will not carry the new entitlement.
  lane :fetch_profiles_tvos do |options|
    cfg = JSON.parse(File.read(File.expand_path("~/.appstoreconnect/config.json")))
    key_path = File.expand_path(cfg["privateKeyPath"])
    [TVOS_BUNDLE_ID, "#{TVOS_BUNDLE_ID}.shelf"].each do |bundle|
      UI.message("Fetching tvOS App Store profile for #{bundle}")
      sigh(
        api_key:        api_key,
        app_identifier: bundle,
        platform:       "tvos",
        force:          options[:force] ? true : false
      )
    end
    UI.success("tvOS provisioning profiles installed.")
  end

  # Archive the tvOS Release build and upload the binary to ASC / TestFlight.
  # This is the lane that was missing — tvOS previously required a manual
  # Xcode archive+upload before submit_tvos could run.
  lane :build_and_upload_tvos do
    check_xcode
    check_version_match
    ensure_fresh_build_number("TV_OS")

    # Provisioning must be fetched BEFORE export. The tvOS targets use manual
    # signing, and `archive` will happily succeed without valid profiles — it is
    # `exportArchive` that fails, after the long part is already done.
    fetch_profiles_tvos(force: true)

    build_app(
      project:        XCODEPROJ,
      scheme:         TVOS_SCHEME,
      configuration:  "Release",
      export_method:  "app-store",
      destination:    "generic/platform=tvOS",
      clean:          true,
      output_directory: File.join(ROOT, "build"),
      output_name:    "DSM Video tvOS.ipa",
      # MANUAL SIGNING FOR THE ARCHIVE TOO, not just the export.
      #
      # The export_options below already pinned the AppStore profiles, but the ARCHIVE ran
      # with the project's Automatic signing. Automatic asks Xcode to resolve a profile
      # itself, and with no signed-in Apple ID it fails:
      #
      #   error: No Accounts: Add a new account in Accounts settings.
      #   error: No profiles for 'HeiloProjects.DSReel' were found: Xcode couldn't find any
      #          tvOS App DEVELOPMENT provisioning profiles matching 'HeiloProjects.DSReel'.
      #
      # Note "Development" — sigh had just installed the AppStore profiles, which is why the
      # error looks contradictory. Automatic signing wants a development profile to archive
      # with, regardless of the export method.
      #
      # Forcing manual signing with the profiles fetch_profiles_tvos just installed makes
      # the archive use the same ones the export will. The project keeps Automatic for
      # everyday Xcode use and for Xcode Cloud, which HAS an account; only this lane
      # overrides it.
      # NOTE: signing settings are NOT passed via xcargs. An xcarg applies to EVERY target
      # in the build, so a single PROVISIONING_PROFILE_SPECIFIER would hand the app's
      # profile to the Top Shelf extension, whose bundle id is different and would not
      # match. The per-target Release settings live in the project instead — see the tvOS
      # app and Top Shelf build configurations.
      xcargs:         "-allowProvisioningUpdates",
      export_team_id: TEAM_ID,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          TVOS_BUNDLE_ID            => "#{TVOS_BUNDLE_ID} AppStore",
          "#{TVOS_BUNDLE_ID}.shelf" => "#{TVOS_BUNDLE_ID}.shelf AppStore"
        }
      }
    )
    upload_to_testflight(
      api_key:             api_key,
      app_identifier:      TVOS_BUNDLE_ID,
      app_platform:        "appletvos",
      ipa:                 File.join(ROOT, "build", "DSM Video tvOS.ipa"),
      skip_waiting_for_build_processing: true,
      skip_submission:     true
    )
  end

  lane :upload_metadata_tvos do
    deliver(
      api_key:             api_key,
      app_identifier:      TVOS_BUNDLE_ID,
      app_version:         VERSION,
      metadata_path:       "metadata/tvos",
      platform:            "appletvos",
      skip_binary_upload:  true,
      skip_screenshots:    true,
      force:               true,
      run_precheck_before_submit: false,
      app_review_information: {
        first_name:    File.read("metadata/tvos/en-US/review_information/first_name.txt").strip,
        last_name:     File.read("metadata/tvos/en-US/review_information/last_name.txt").strip,
        phone_number:  File.read("metadata/tvos/en-US/review_information/phone_number.txt").strip,
        email_address: File.read("metadata/tvos/en-US/review_information/email_address.txt").strip,
        notes:         File.read("metadata/tvos/en-US/review_information/notes.txt").strip
      }
    )
  end

  lane :submit_tvos do
    # See the iOS :submit lane: set, read back, fail before submit.
    push_store_text("TV_OS")
    verify_store_text("TV_OS")
    deliver(
      api_key:             api_key,
      app_identifier:      TVOS_BUNDLE_ID,
      app_version:         VERSION,
      metadata_path:       "metadata/tvos",
      platform:            "appletvos",
      skip_binary_upload:  true,
      skip_screenshots:    true,
      # skip_metadata only because the text was set + verified above; see iOS :submit.
      skip_metadata:       true,
      submit_for_review:   true,
      automatic_release:   true,
      force:               true,
      run_precheck_before_submit: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa:             false
      }
    )
  end

  # One-shot: upload tvOS metadata (What's New + promo text), THEN submit.
  lane :release_tvos do
    upload_metadata_tvos
    submit_tvos
  end

  # Full tvOS pipeline from a clean checkout: archive → upload → metadata → submit.
  lane :ship_tvos do
    build_and_upload_tvos
    UI.important("tvOS binary uploaded. Waiting for ASC processing before submit...")
    wait_for_processing(platform_name: "TV_OS")
    release_tvos
  end

end

# ──────────────────────────────────────────────────────
# Both platforms, one command
# ──────────────────────────────────────────────────────
platform :ios do
  lane :ship_all do
    ship_ios
    ship_tvos
  end
end

# ──────────────────────────────────────────────────────
# Diagnostics / helpers
# ──────────────────────────────────────────────────────

def asc_token
  cfg = JSON.parse(File.read(File.expand_path("~/.appstoreconnect/config.json")))
  require 'spaceship'
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id:   cfg["keyId"],
    issuer_id: cfg["issuerId"],
    filepath: File.expand_path(cfg["privateKeyPath"])
  )
end

# Poll ASC until a VALID build exists for VERSION on the given platform.
# platform_name is "IOS" or "TV_OS".
def wait_for_processing(platform_name:, timeout_min: 45)
  asc_token
  app = Spaceship::ConnectAPI::App.find(IOS_BUNDLE_ID)
  deadline = Time.now + (timeout_min * 60)
  loop do
    build = app.get_builds(includes: "preReleaseVersion", limit: 20).find do |b|
      b.pre_release_version&.version == VERSION && b.processing_state == "VALID"
    end
    if build
      UI.success("Build #{VERSION} (#{build.version}) is VALID and ready to submit.")
      return build
    end
    if Time.now > deadline
      UI.user_error!("Timed out after #{timeout_min}m waiting for a VALID #{VERSION} build.")
    end
    UI.message("Still processing... re-checking in 60s")
    sleep 60
  end
end

# ──────────────────────────────────────────────────────
# Store text (What's New + promo text) — set explicitly, read back, fail if wrong.
#
# `deliver` reports success while leaving whatsNew / promotionalText EMPTY, and does so
# non-deterministically (1.3.6, and both platforms of 1.3.8: blank after the first submit,
# fine after the second). So the release lanes no longer trust deliver for these two
# fields: they write them through the ASC API, re-read them from ASC, and abort BEFORE
# the submit if either differs from the files in metadata/<platform>/<locale>/.
# ──────────────────────────────────────────────────────
STORE_TEXT_FILES = { "whatsNew" => "release_notes.txt", "promotionalText" => "promotional_text.txt" }.freeze

def metadata_dir_for(plat)
  plat == "TV_OS" ? "tvos" : "ios"
end

# The ASC version record for VERSION on plat, or a hard failure.
def asc_version_for(plat)
  asc_token
  app = Spaceship::ConnectAPI::App.find(IOS_BUNDLE_ID)
  v = app.get_app_store_versions(filter: { versionString: VERSION, platform: plat }).first
  UI.user_error!("No #{plat} #{VERSION} version record in ASC (run create_version_and_metadata first)") if v.nil?
  v
end

# { "en-US" => { "whatsNew" => "...", "promotionalText" => "..." } } for every locale
# folder that exists on disk. A missing or empty source file is an error here, so the
# files are the single place the text lives.
def store_text_from_disk(plat)
  base = File.join(__dir__, "metadata", metadata_dir_for(plat))
  out = {}
  Dir.children(base).sort.each do |locale|
    next unless File.directory?(File.join(base, locale))
    entry = {}
    STORE_TEXT_FILES.each do |attr, file|
      path = File.join(base, locale, file)
      text = File.exist?(path) ? File.read(path).strip : ""
      UI.user_error!("#{path} is missing or empty - cannot set #{attr}") if text.empty?
      entry[attr] = text
    end
    out[locale] = entry
  end
  UI.user_error!("No locale folders under #{base}") if out.empty?
  out
end

# Write What's New + promo text onto every localization that has source files.
def push_store_text(plat)
  wanted = store_text_from_disk(plat)
  v = asc_version_for(plat)
  v.get_app_store_version_localizations.each do |loc|
    text = wanted[loc.locale]
    if text.nil?
      UI.important("#{plat} #{loc.locale}: no metadata folder, leaving untouched")
      next
    end
    loc.update(attributes: text)
    UI.success("#{plat} #{loc.locale}: set whatsNew (#{text['whatsNew'].length} chars) + promotionalText (#{text['promotionalText'].length} chars)")
  end
end

# Re-read from ASC (fresh fetch, not the objects we just wrote) and FAIL unless both
# fields are non-empty and equal to the files. Call immediately before submitting.
def verify_store_text(plat)
  wanted = store_text_from_disk(plat)
  v = asc_version_for(plat)
  locs = v.get_app_store_version_localizations
  problems = []
  wanted.each do |locale, text|
    loc = locs.find { |l| l.locale == locale }
    if loc.nil?
      problems << "#{locale}: no localization in ASC"
      next
    end
    { "whatsNew" => loc.whats_new, "promotionalText" => loc.promotional_text }.each do |attr, actual|
      if actual.to_s.strip.empty?
        problems << "#{locale}: #{attr} is EMPTY in ASC"
      elsif actual.to_s.strip != text[attr]
        problems << "#{locale}: #{attr} in ASC differs from metadata file"
      end
    end
  end
  UI.user_error!("#{plat} store text not ready, NOT submitting:\n  " + problems.join("\n  ")) unless problems.empty?
  UI.success("#{plat} #{VERSION}: What's New + promo text read back from ASC and verified (#{wanted.keys.join(', ')}).")
end

# ──────────────────────────────────────────────────────
# Build numbers
# ──────────────────────────────────────────────────────

# Every build of VERSION on plat, any processing state, as [number, Build] sorted ascending.
def asc_builds_for(plat)
  asc_token
  app = Spaceship::ConnectAPI::App.find(IOS_BUNDLE_ID)
  Spaceship::ConnectAPI::Build.all(
    app_id: app.id, version: VERSION, platform: plat,
    processing_states: "PROCESSING,FAILED,INVALID,VALID", includes: "preReleaseVersion", limit: 200
  ).select { |b| b.pre_release_version&.platform == plat }
   .map { |b| [b.version.to_i, b] }.sort_by(&:first)
end

def project_build_number
  nums = File.read("#{XCODEPROJ}/project.pbxproj").scan(/CURRENT_PROJECT_VERSION = ([0-9]+);/).flatten.uniq
  UI.user_error!("CURRENT_PROJECT_VERSION is not uniform across targets: #{nums.join(', ')}") unless nums.size == 1
  nums.first.to_i
end

def write_project_build_number(n)
  path = "#{XCODEPROJ}/project.pbxproj"
  File.write(path, File.read(path).gsub(/CURRENT_PROJECT_VERSION = [0-9]+;/, "CURRENT_PROJECT_VERSION = #{n};"))
end

# Called by the upload lanes before archiving: never upload a build number ASC already
# has for VERSION on this platform. If the project number collides or is behind, bump it
# (every target) to highest+1 so the archive carries the new number.
# Commit the resulting pbxproj change after the upload.
def ensure_fresh_build_number(plat)
  highest = asc_builds_for(plat).map(&:first).max || 0
  mine = project_build_number
  if mine > highest
    UI.success("Build number #{mine} is free for #{plat} #{VERSION} (ASC highest: #{highest}).")
  else
    write_project_build_number(highest + 1)
    UI.important("Build #{mine} already exists in ASC for #{plat} #{VERSION} (highest #{highest}). CURRENT_PROJECT_VERSION bumped to #{highest + 1} in all targets - commit it.")
  end
end

# Choose the build to attach: the requested number, else the highest VALID one. Prints it.
def pick_build_to_attach(plat, requested)
  valid = asc_builds_for(plat).select { |_, b| b.processing_state == "VALID" }
  UI.user_error!("No VALID #{plat} #{VERSION} build found to attach") if valid.empty?
  UI.message("VALID #{plat} #{VERSION} builds: #{valid.map(&:first).join(', ')}")
  if requested.to_s.empty?
    num, build = valid.last
  else
    num, build = valid.find { |n, _| n == requested.to_i }
    UI.user_error!("Build #{requested} is not a VALID #{plat} #{VERSION} build (valid: #{valid.map(&:first).join(', ')})") if build.nil?
  end
  UI.message("Selected #{plat} build #{num} (#{requested.to_s.empty? ? 'highest processed' : 'requested'}).")
  build
end

platform :ios do
  # Report which capabilities each App ID actually has on the developer portal.
  # App Groups must be enabled on BOTH the tvOS app and the Top Shelf App ID, or
  # exportArchive fails with "requires a provisioning profile with the App Groups
  # feature" no matter how many times you refetch profiles.
  lane :check_capabilities do
    asc_token
    [IOS_BUNDLE_ID, "#{IOS_BUNDLE_ID}.shelf", WIDGET_BUNDLE_ID].each do |bid|
      b = Spaceship::ConnectAPI::BundleId.all.find { |x| x.identifier == bid }
      if b.nil?
        UI.error("#{bid}: NOT FOUND on the developer portal")
        next
      end
      caps = b.get_capabilities.map(&:capability_type)
      has = caps.include?("APP_GROUPS")
      UI.message("#{bid}")
      UI.message("   APP_GROUPS: #{has ? 'ENABLED' : 'MISSING  <-- this blocks export'}")
      UI.message("   all caps:   #{caps.join(', ')}")
    end
  end
end

platform :ios do
  lane :verify_build do
    n = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: IOS_BUNDLE_ID,
      version: VERSION
    )
    UI.message("LATEST_#{VERSION}_BUILD=#{n}")
  end
end

platform :ios do
  lane :upload_existing_ipa do
    # Refuse a build number ASC already has (read from the ipa itself, not the project).
    ipa = File.join(ROOT, "build", "DSM Video.ipa")
    ipa_build = `unzip -p "#{ipa}" "Payload/*.app/Info.plist" | plutil -extract CFBundleVersion raw -o - -`.strip
    UI.user_error!("Could not read CFBundleVersion from #{ipa}") unless ipa_build =~ /\A[0-9]+\z/
    if asc_builds_for("IOS").map(&:first).include?(ipa_build.to_i)
      UI.user_error!("ASC already has iOS #{VERSION} build #{ipa_build}; rebuild with a higher number (build_and_upload auto-increments).")
    end
    upload_to_testflight(
      api_key: api_key,
      app_identifier: IOS_BUNDLE_ID,
      ipa: File.join(ROOT, "build", "DSM Video.ipa"),
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
    UI.success("UPLOAD_LANE_DONE")
  end
end

